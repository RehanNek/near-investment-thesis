# Copy to .env and fill in. .env is git-ignored; never commit real values.

# NEAR Intents partner JWT, from https://partners.near-intents.org
# Used for the Explorer API (https://explorer.near-intents.org/api/v0), sent as "Authorization: Bearer <token>"
NEAR_INTENTS_JWT=

# Google Cloud project used for BigQuery queries (sandbox is fine)
GCP_PROJECT_ID=
